{
  "name": "healthbridge",
  "version": "2.0.0",
  "private": true,
  "description": "HealthBridge: a user-controlled accessibility copilot for patient portals (Chrome MV3 side panel extension).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "demo": "node scripts/serve.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test \"test/unit/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "puppeteer": "^25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
